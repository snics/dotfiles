{
  "defaultRuntimeMode": "auto",
  "defaultModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6.1-sol"
  },
  "autoResumeLimitedThreads": true,
  "snoozeLimitedThreads": true,
  "removeAgentCreditsOnMerge": true,
  "branchNamingMode": "semantic",
  "addProjectBaseDirectory": "~/Projects",
  "enableProviderUpdateChecks": false,
  "worktreesDirectory": "~/Projects/_worktrees",
  "worktreeCleanup": {
    "mode": "off"
  },
  "defaultProjectScripts": [
    {
      "id": "wt-hooks",
      "name": "Worktrunk hooks",
      "command": "wt hook pre-start && wt hook post-start --foreground",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    }
  ],
  "providerInstances": {
    "claudeAgent": {
      "driver": "claudeAgent",
      "displayName": "Claude Privat",
      "accentColor": "#D97757",
      "enabled": true,
      "config": {
        "binaryPath": "claude",
        "homePath": "~/.t3/userdata/providers/claudeAgent/claudeAgent/home"
      }
    },
    "claudeWork": {
      "driver": "claudeAgent",
      "displayName": "Claude Work",
      "accentColor": "#5B8DEF",
      "enabled": true,
      "config": {
        "binaryPath": "claude",
        "homePath": "~/.t3/userdata/providers/claudeAgent/claudeWork/home"
      }
    },
    "codex": {
      "driver": "codex",
      "displayName": "Codex",
      "enabled": true,
      "config": {
        "setupMode": "existing",
        "binaryPath": "codex"
      }
    }
  },
  "defaultThreadEnvMode": "worktree",
  "storageCleanup": {
    "browserArtifactsAfterDays": 30,
    "logsAfterDays": 30
  }
}
