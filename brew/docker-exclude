# Formulae to exclude from Docker devenv builds.
# One formula name per line (exact match against brew "name" in Brewfile.*).
# Lines starting with # are comments.
#
# See also: linux-exclude (subset — shared Linux-incompatible packages)

# macOS-only tools (no Linux equivalent)
mas
mackup
reattach-to-user-namespace
trash
lotyp/formulae/dockutil

# Requires hardware, VM, or Docker daemon on host
cirruslabs/cli/tart
lima
qemu
minikube
kind
aircrack-ng
# krunkit is a macOS/Apple Silicon VM provider; the docker CLI itself is
# intentionally NOT excluded (docker-compose is already in the image).
libkrun/krun/krunkit

# Already provided by base image (properly compiled, no Homebrew deps)
neovim
curl

# No Linux bottle / build fails on Linux
herdr
# herdrctx manages herdr sessions — pointless without herdr
j0urneyk/tap/herdrctx
krr
rename
robusta-dev/holmesgpt/holmesgpt

# Too large for container image (install on demand if needed)
swift
imagemagick
numpy
