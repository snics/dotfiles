#!/usr/bin/env bash
# wt-issue — GitLab issue → worktrunk worktree → agent, in one command.
#
# Invoked as `wt issue …` (worktrunk custom subcommand: any wt-<name> on PATH)
# or directly as `wt-issue …`.
#
# Usage:
#   wt issue <N> [--agent claude|codex] [--no-agent] [--branch-only] [--base <ref>]
#                [--mr|--no-mr]
#
#   <N>            GitLab issue number (repo derived from the git remote via glab)
#   --agent        Agent to exec inside the worktree (default: claude)
#   --no-agent     Only create/switch the worktree (humans, herdr quick actions)
#   --branch-only  Print the derived branch name (<N>-<slug>) and exit —
#                  used by the wt-issue agent skill so Claude Code can create
#                  the worktree through its EnterWorktree tool instead
#   --base <ref>   Base ref for a new branch (default: repo default branch)
#   --mr/--no-mr   Force MR mode on/off, overriding the stored decision and the
#                  repo heuristic (last one wins). Deliberately not --no-merge:
#                  `wt merge` is worktrunk's local squash-merge, a different act
#
# The branch name follows GitLab's own %{id}-%{title} pattern, so MRs created
# from it link back to the issue automatically.
#
# MR mode decides whether `wt publish` opens a draft MR on the first push.
# Precedence: explicit flag > decision stored at the branch > repo heuristic.
# The heuristic is deliberately narrow — a pushable remote plus a .gitlab-ci.yml
# that mentions merge_request_event, i.e. exactly the case where no MR means no
# pipeline at all. Repos without MR pipelines get nothing they have to clean up.
# Label policy stays out of here; this is only about the MR existing.
set -euo pipefail

die() { printf 'wt-issue: %s\n' "$*" >&2; exit 1; }

issue="" agent="claude" no_agent=false branch_only=false base=""
# Empty means "not given" — the stored decision or the heuristic then answers.
mr_flag=""
while (( $# )); do
  case "$1" in
    --agent)       agent="${2:?--agent needs a value}"; shift 2 ;;
    --no-agent)    no_agent=true; shift ;;
    --branch-only) branch_only=true; shift ;;
    --base)        base="${2:?--base needs a value}"; shift 2 ;;
    --mr)          mr_flag=true; shift ;;
    --no-mr)       mr_flag=false; shift ;;
    -h|--help)     sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)            die "unknown flag: $1" ;;
    *)             issue="$1"; shift ;;
  esac
done
[[ "$issue" =~ ^[0-9]+$ ]] || die "usage: wt issue <N> [--agent claude|codex] [--no-agent] (got: '${issue:-}')"
# Allowlist: --agent ends up as `wt switch --execute`, so an arbitrary value
# would be an arbitrary command — including when an agent calls this script.
case "$agent" in
  claude|codex|opencode) ;;
  *) die "unsupported --agent '$agent' (allowed: claude, codex, opencode)" ;;
esac

command -v glab >/dev/null || die "glab is required"
command -v jq   >/dev/null || die "jq is required"
command -v wt   >/dev/null || die "worktrunk (wt) is required"
git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"

json="$(glab issue view "$issue" -F json 2>/dev/null)" \
  || die "could not fetch issue #$issue (glab auth for this host? inside the right repo?)"
title="$(jq -r '.title // empty' <<<"$json")"
state="$(jq -r '.state // empty' <<<"$json")"
[[ -n "$title" ]] || die "issue #$issue has no title (unexpected glab output)"
[[ "$state" == "closed" ]] && printf 'wt-issue: warning: issue #%s is closed\n' "$issue" >&2

# GitLab-style slug: lowercase, non-alnum → '-', squeezed, trimmed, capped.
slug="$(printf '%s' "$title" \
  | tr '[:upper:]' '[:lower:]' \
  | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
if (( ${#slug} > 48 )); then
  # Cap without cutting mid-word: truncate, then drop the partial last segment.
  slug="$(printf '%s' "${slug:0:48}" | sed -E 's/-[^-]*$//; s/-+$//')"
fi
# A title made purely of non-ASCII or symbols sanitizes to nothing, which would
# yield a trailing-dash branch like "142-".
[[ -n "$slug" ]] || slug="issue"
branch="${issue}-${slug}"

# MR mode — flag > stored decision > heuristic. Stored at the branch rather
# than in the worktree: worktrees share one .git/config, so a --local key would
# be repo-wide and every ticket would overwrite the previous one. git drops the
# whole branch.<name> section when the branch is deleted, so `wt remove` cleans
# up after itself.
mr_key="branch.${branch}.wtIssueMr"
mr_stored="$(git config --get --bool "$mr_key" 2>/dev/null || true)"
if [[ -n "$mr_flag" ]]; then
  mr_mode="$mr_flag"
  if [[ "$mr_flag" == true ]]; then mr_why="--mr"; else mr_why="--no-mr"; fi
  git config --local "$mr_key" "$mr_mode"
elif [[ -n "$mr_stored" ]]; then
  # Re-entry: never re-run the heuristic. A .gitlab-ci.yml edited in the
  # meantime must not silently flip a decision the branch already carries.
  mr_mode="$mr_stored"
  mr_why="stored"
else
  root="$(git rev-parse --show-toplevel)"
  if [[ -n "$(git remote)" ]] && [[ -f "$root/.gitlab-ci.yml" ]] \
     && grep -q 'merge_request_event' "$root/.gitlab-ci.yml"; then
    mr_mode=true;  mr_why="MR pipelines in .gitlab-ci.yml"
  else
    mr_mode=false; mr_why="no MR pipelines detected"
  fi
  git config --local "$mr_key" "$mr_mode"
fi
# stderr: --branch-only writes the branch name to stdout for callers to read.
if [[ "$mr_mode" == true ]]; then
  printf 'wt-issue: MR mode on (%s) — publish with: wt publish\n' "$mr_why" >&2
else
  printf 'wt-issue: MR mode off (%s)\n' "$mr_why" >&2
fi

if $branch_only; then
  printf '%s\n' "$branch"
  exit 0
fi

# Re-entry: drop --create when the branch already exists. Built without ever
# expanding an empty array — "${arr[@]}" on an empty array aborts under
# `set -u` in bash 3.2, which is what /bin/bash is on macOS.
wt_args=(switch)
if git show-ref --verify --quiet "refs/heads/$branch"; then
  creating=false
else
  wt_args+=(--create)
  creating=true
fi
if $creating && [[ -n "$base" ]]; then
  wt_args+=(--base "$base")
fi
wt_args+=("$branch")

if $no_agent; then
  exec wt "${wt_args[@]}"
fi

# Short opening prompt; braces stripped so worktrunk's template engine never
# sees {{ … }}. The agent pulls the full description/comments itself — always
# fresh, no escaping hazards.
safe_title="$(printf '%s' "$title" | sed 's/{/(/g; s/}/)/g')"
mr_note="MR mode is off for this branch: publish with 'wt publish' when you need the branch on the remote, and merge locally with 'wt merge'."
if [[ "$mr_mode" == true ]]; then
  mr_note="MR mode is on for this branch: publish with 'wt publish' (never a raw 'git push') — the first push opens a draft MR that closes #${issue}. Do NOT run 'wt merge' on this branch; it merges locally and bypasses the MR."
fi
prompt="Work on GitLab issue #${issue}: ${safe_title}. First run 'glab issue view ${issue}' and 'glab issue view ${issue} --comments' to load the description, acceptance criteria and discussion. Then, BEFORE writing any code: run a brainstorming/alignment round with the user (use the superpowers:brainstorming skill if available) — summarize your understanding of the issue, ask whether anything has changed since it was written, and clarify open questions and acceptance criteria. Only start implementing after the user confirms the direction. ${mr_note} If a project workflow skill exists, follow it for labels and reviewers."
exec wt "${wt_args[@]}" -x "$agent" -- "$prompt"
