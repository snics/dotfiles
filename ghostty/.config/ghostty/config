font-family = "Lilex Nerd Font"
font-size = 16
theme = "Catppuccin Mocha"
background = "#181825"

# Brighten ANSI 8 ("bright black") from Catppuccin Surface2 (#585b70) to
# Overlay1 (#7f849c) so dimmed/secondary text stays readable on the dark
# background across all terminal tools (git/delta, lazygit, k9s, Claude Code).
# Zsh autosuggestions are pinned back to #585b70 to remain ghosted.
palette = 8=#7f849c

# Faint/dim text (SGR 2) is used by Claude Code et al. for secondary text;
# the 0.5 default blends it halfway to the background and tanks readability.
# Raise it so muted text stays legible. Solid-color "ghost" text (zsh
# autosuggestions, comments) is unaffected — only the faint attribute.
faint-opacity = 0.8

background-opacity = 0.9
background-blur-radius = 50
cursor-style = "underline"

# Ghostty is a pure herdr host: every window attaches to the persistent
# herdr session (tabs/panes/workspaces live in herdr, not Ghostty).
# Closing the window only detaches the client — agents keep running.
command = /opt/homebrew/bin/herdr

# No Ghostty tabs (herdr owns tabs), so hide the titlebar entirely.
macos-titlebar-style = hidden

# Send Option as Alt so alt+h/j/k/l (herdr pane resize) reaches herdr
# instead of typing macOS special characters.
macos-option-as-alt = true

# ============================================================================
# Keybindings — Vim-style (Ctrl+Shift layer)
# ============================================================================

# Pane navigation (hjkl)
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right

# Pass Cmd+1..9 through to herdr (direct workspace switching) — Ghostty's
# default goto_tab bindings would swallow them, and Ghostty tabs are unused.
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+digit_9=unbind

# Create splits — note: with command = herdr each split is another client
# attached to the same session (mirrored view). Use herdr splits instead;
# these stay bound only for the rare second-view-of-the-session case.
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+minus=new_split:down

# Split management
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits
keybind = ctrl+shift+w=close_surface

# Resize splits (arrow keys)
keybind = ctrl+shift+left=resize_split:left,10
keybind = ctrl+shift+down=resize_split:down,10
keybind = ctrl+shift+up=resize_split:up,10
keybind = ctrl+shift+right=resize_split:right,10
